# Adviento Express · variables de entorno (copia a .env para tus notas; .env no se sube)

# --- Web (Vercel → Settings → Environment Variables). Son públicas: acaban en config.js ---
ADVX_TAG=tu-tag-21                       # ID de afiliado de Amazon
ADVX_SITE_URL=https://adviento.example   # URL pública (enlaces de compartir y Open Graph)
SUPABASE_URL=https://<ref>.supabase.co   # Project URL
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # o la anon key antigua (eyJ…)

# --- Edge Function submit-run (npx supabase secrets set …). SUPABASE_URL y
#     SUPABASE_SERVICE_ROLE_KEY las pone Supabase solo, no hay que definirlas ---
RUN_SALT=<32 caracteres aleatorios>      # sal para el hash del dispositivo (no la cambies a mitad de temporada)
ALLOWED_ORIGINS=https://adviento.example,http://localhost:5173
SEASON=2026
ALLOW_ANY_DAY=0                          # 1 = acepta días aún cerrados (solo para probar antes de diciembre)
