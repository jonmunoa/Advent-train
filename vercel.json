{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo sin dependencias",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {"source": "/escaparates.html", "destination": "/", "permanent": true},
    {"source": "/pruebas/", "destination": "/pruebas", "permanent": false}
  ],
  "rewrites": [
    {"source": "/pruebas", "destination": "/index.html"}
  ],
  "headers": [
    {
      "source": "/pruebas",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}, {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    },
    {
      "source": "/m/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400"}]
    },
    {
      "source": "/(og.jpg|og-escaparates.jpg|favicon.svg)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]
    },
    {
      "source": "/(src/.*|config.js)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    }
  ]
}
